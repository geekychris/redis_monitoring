{
  "name": "System Metrics Dashboard",
  "refreshInterval": 2000,
  "widgets": [
    {
      "id": "cpu-usage",
      "title": "CPU Usage",
      "redisKey": "metric:cpu_usage",
      "type": "gauge",
      "format": "percentage",
      "unit": "%",
      "min": 0,
      "max": 100,
      "width": 3,
      "height": 1
    },
    {
      "id": "memory-usage",
      "title": "Memory Usage",
      "redisKey": "metric:memory_mb",
      "type": "gauge",
      "unit": "MB",
      "min": 0,
      "max": 8192,
      "width": 3,
      "height": 1
    },
    {
      "id": "total-requests",
      "title": "Total Requests",
      "redisKey": "metric:total_requests",
      "type": "counter",
      "format": "number",
      "width": 3,
      "height": 1
    },
    {
      "id": "error-count",
      "title": "Error Count",
      "redisKey": "metric:error_count",
      "type": "counter",
      "format": "number",
      "width": 3,
      "height": 1
    },
    {
      "id": "response-time",
      "title": "Avg Response Time",
      "redisKey": "metric:avg_response_time_ms",
      "type": "counter",
      "format": "milliseconds",
      "width": 3,
      "height": 1
    },
    {
      "id": "active-connections",
      "title": "Active Connections",
      "redisKey": "metric:active_connections",
      "type": "counter",
      "format": "number",
      "width": 3,
      "height": 1
    },
    {
      "id": "requests-per-sec",
      "title": "Requests Per Second",
      "redisKey": "metric:timeseries:requests_per_sec",
      "type": "line-chart",
      "width": 6,
      "height": 2
    }
  ]
}
